SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
SEPOLIA_PRIVATE_KEY=0xyour_test_wallet_private_key
SEPOLIA_VENDOR_PRIVATE_KEY=0xoptional_secondary_test_wallet_private_key
FINALIZER_PRIVATE_KEY=0xdedicated_gas_funded_test_wallet_private_key
FINALIZER_ACTION_BUDGET=3
FINALIZER_POLL_INTERVAL_MS=30000
FINALIZER_PROOF_ATTEMPTS=3
FINALIZER_PROOF_DELAY_MS=5000
FINALIZER_HEALTH_HOST=127.0.0.1
FINALIZER_HEALTH_PORT=8787
# Required for writes only while the generated deployment has verified=false.
VEILBID_ALLOW_UNVERIFIED_DEPLOYMENT=false

# Flare Coston2 foundation and deployment (testnet only)
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_DEPLOYMENT_PRIVATE_KEY=your_disposable_coston2_key

# Verified Coston2 market and stateless lifecycle relay
FLARE_MARKET_ADDRESS=0xyour_verified_market
FLARE_MARKET_DEPLOYMENT_BLOCK=0
FLARE_DEPLOYMENT_STATUS=planned
FLARE_FINALIZER_PRIVATE_KEY=your_dedicated_coston2_finalizer_key
FLARE_FCC_PROXY_URLS=https://tee-1.example,https://tee-2.example,https://tee-3.example
FLARE_FCC_EXTENSION_VERSION=0.2.0
FLARE_FCC_INSTRUCTION_FEE_WEI=1000000
FLARE_ACTION_BUDGET=1

# Public browser configuration; never place credentials in VITE_* variables.
VITE_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
VITE_FLARE_MARKET_ADDRESS=0xyour_verified_market
VITE_FLARE_MARKET_DEPLOYMENT_BLOCK=0
VITE_FLARE_DEPLOYMENT_STATUS=planned

# FCC Gate 0 external infrastructure. Never use a rotating quick tunnel.
EXT_PROXY_URL=https://your-stable-fcc-proxy.example
VEILBID_FCC_TEE_IDS=0xpublic_tee_id_1,0xpublic_tee_id_2,0xpublic_tee_id_3
FCC_INDEXER_HOST=your_current_indexer_host
FCC_INDEXER_USER=your_current_indexer_user
FCC_INDEXER_PASSWORD=your_current_indexer_password
