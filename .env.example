XRPL_FDC_CONFIRMATIONS=3
FLARE_FUNDING_POLL_INTERVAL_MS=15000
FLARE_FUNDING_POLL_ATTEMPTS=80

# Public browser configuration; never place credentials in VITE_* variables.
VITE_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
VITE_FLARE_MARKET_ADDRESS=0xFaEDc6793E72AFF05d29e6f0550d0FF8b90c4c05
VITE_FLARE_MARKET_DEPLOYMENT_BLOCK=33746695
VITE_FLARE_DEPLOYMENT_STATUS=verified
VITE_FLARE_INGRESS_URL=https://veilbid-flare-ingress-production.up.railway.app

# FCC Gate 0 external infrastructure. FLARE_FCC_PROXY_URLS above must contain
# three distinct stable origins; never use a rotating quick tunnel.
# For hosted machines, set FCC_PROXY_CONTROL_URLS to those same origins so the
# registration client reads each remote identity directly. Leave it unset for
# the local Compose stack, which defaults to loopback ports 6674-6676.
FCC_PROXY_CONTROL_URLS=
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
FLAREQUORUM_FCC_TEE_IDS=0xpublic_tee_id_1,0xpublic_tee_id_2,0xpublic_tee_id_3
FCC_INDEXER_HOST=your_current_indexer_host
FCC_INDEXER_PORT=3306
FCC_INDEXER_DATABASE=indexer
FCC_INDEXER_USER=your_current_indexer_user
FCC_INDEXER_PASSWORD=your_current_indexer_password
PROXY_PRIVATE_KEY_1=your_dedicated_coston2_proxy_key_1
FCC_DIRECT_API_KEY_1=your_random_private_ingress_api_key_1
PROXY_PRIVATE_KEY_2=your_dedicated_coston2_proxy_key_2
FCC_DIRECT_API_KEY_2=your_random_private_ingress_api_key_2
PROXY_PRIVATE_KEY_3=your_dedicated_coston2_proxy_key_3
