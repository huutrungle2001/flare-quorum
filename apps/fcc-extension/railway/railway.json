{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/fcc-extension/railway/Dockerfile",
    "watchPatterns": [
      "apps/fcc-extension/**",
      "tooling/flare/coston2-foundations.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/info",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
