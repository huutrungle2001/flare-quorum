#!/bin/sh

set -eu

# This repository is the Flare product; the legacy VeilBid remote is out of scope.
remote_name=${1-}
remote_url=${2-}

case "$remote_url" in
  *huutrungle2001/flare-quorum.git)
    exit 0
    ;;
  *)
    echo "FlareQuorum push blocked: remote is not huutrungle2001/flare-quorum.git" >&2
    echo "remote=${remote_name} url=${remote_url}" >&2
    exit 1
    ;;
esac
