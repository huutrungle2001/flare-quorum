    "verify:deployment:release": "pnpm --filter @flarequorum/auction-house verify:deployment:release",
    "verify:deployment:test": "pnpm --filter @flarequorum/auction-house verify:deployment:test",
    "flare:foundations:check": "node --env-file-if-exists=.env.local tooling/scripts/check-flare-foundations.mjs",
    "flare:foundations:collect": "node --env-file-if-exists=.env.local tooling/scripts/check-flare-foundations.mjs --write",
    "flare:gate:0": "node --env-file-if-exists=.env.local tooling/scripts/check-flare-foundations.mjs --write --require-complete",
    "flare:local:secrets": "node tooling/scripts/ensure-fcc-local-secrets.mjs",
    "flare:local:smoke": "node --env-file-if-exists=.env.local tooling/scripts/verify-fcc-local-stack.mjs",
    "flare:proxy:config": "node --env-file-if-exists=.env.local tooling/scripts/render-fcc-proxy-config.mjs",
    "flare:extension:image:build": "node tooling/scripts/build-fcc-extension-image.mjs --build --write",
    "flare:extension:image:verify": "node tooling/scripts/build-fcc-extension-image.mjs --write",
    "flare:foundation:register:preflight": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/deploy-register-fcc-foundation.mjs",
    "flare:foundation:register": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/deploy-register-fcc-foundation.mjs --execute",
    "flare:foundation:registration:verify": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/verify-fcc-foundation-registration.mjs",
    "flare:code-version:preflight": "node --env-file-if-exists=.env.local tooling/scripts/allow-fcc-code-version.mjs",
    "flare:code-version:allow": "node --env-file-if-exists=.env.local tooling/scripts/allow-fcc-code-version.mjs --execute",
    "flare:governance:preflight": "node --env-file-if-exists=.env.local tooling/scripts/set-fcc-governance.mjs",
    "flare:governance:set": "node --env-file-if-exists=.env.local tooling/scripts/set-fcc-governance.mjs --execute",
    "flare:market:governance:preflight": "FCC_GOVERNANCE_REGISTRATION_EVIDENCE_PATH=evidence/coston2/fcc-market-extension-registration.json FCC_GOVERNANCE_EVIDENCE_PATH=evidence/coston2/fcc-market-governance.json node --env-file-if-exists=.env.local tooling/scripts/set-fcc-governance.mjs",
    "flare:market:governance:set": "FCC_GOVERNANCE_REGISTRATION_EVIDENCE_PATH=evidence/coston2/fcc-market-extension-registration.json FCC_GOVERNANCE_EVIDENCE_PATH=evidence/coston2/fcc-market-governance.json node --env-file-if-exists=.env.local tooling/scripts/set-fcc-governance.mjs --execute",
    "flare:proxy:image:build": "node tooling/scripts/build-fcc-proxy-image.mjs --build --write",
    "flare:proxy:image:verify": "node tooling/scripts/build-fcc-proxy-image.mjs --write",
    "flare:registration:image:build": "node tooling/scripts/build-fcc-registration-image.mjs --build --write",
    "flare:registration:image:verify": "node tooling/scripts/build-fcc-registration-image.mjs --write",
    "flare:machines:preflight": "node --env-file-if-exists=.env.local tooling/scripts/register-fcc-machines.mjs",
    "flare:machines:register": "node --env-file-if-exists=.env.local tooling/scripts/register-fcc-machines.mjs --execute",
    "flare:machines:retirement:preflight": "node --env-file-if-exists=.env.local tooling/scripts/retire-stale-fcc-machines.mjs",
    "flare:machines:retire-stale": "node --env-file-if-exists=.env.local tooling/scripts/retire-stale-fcc-machines.mjs --execute",
    "flare:gate:a": "pnpm --filter @flarequorum/flare-bindings build && node --env-file-if-exists=.env.local tooling/scripts/run-fcc-foundation-action.mjs --execute",
    "flare:gate:b:ingress": "pnpm --filter @flarequorum/flare-bindings build && node --env-file-if-exists=.env.local tooling/scripts/run-fcc-private-ingress.mjs --execute",
    "flare:tunnel:install": "node tooling/scripts/ensure-cloudflared.mjs --install",
    "flare:tunnel:check": "node tooling/scripts/ensure-cloudflared.mjs",
    "flare:mcp": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/operator-console build && node --env-file-if-exists=.env.local apps/console/dist/flare-mcp-stdio.js",
    "flare:verify:foundation": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/verify-flare-foundation-sender.mjs",
  "flare:deploy:market": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/deploy-flare-market.mjs",
  "flare:deploy:market:candidate": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/deploy-flare-market-candidate.mjs",
  "flare:release:promote": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/promote-flare-market-release.mjs",
  "flare:release:refresh": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/promote-flare-market-release.mjs --refresh",
  "flare:register:market-extension": "node --env-file-if-exists=.env.local tooling/scripts/register-fcc-market-extension.mjs",
    "flare:market:lifecycle:preflight": "pnpm --filter @flarequorum/flare-bindings build && node --env-file-if-exists=.env.local tooling/scripts/run-fcc-market-lifecycle.mjs",
    "flare:market:lifecycle": "pnpm --filter @flarequorum/flare-bindings build && node --env-file-if-exists=.env.local tooling/scripts/run-fcc-market-lifecycle.mjs --execute",
    "flare:gate:g:preflight": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local tooling/scripts/run-fcc-gate-g.mjs",
    "flare:gate:g": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local tooling/scripts/run-fcc-gate-g.mjs --execute",
    "flare:relay:health": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-cli.js health",
    "flare:relay:health-server": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-cli.js health-server",
    "flare:relay:dry-run": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-cli.js dry-run",
    "flare:relay:once": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-cli.js once",
    "flare:relay:poll": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-cli.js poll",
    "flare:funding:health": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-funding-cli.js health",
    "flare:funding:execute": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-funding-cli.js execute",
    "flare:funding:resume": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-funding-cli.js resume",
    "flare:benchmarks": "node --env-file-if-exists=.env.local tooling/scripts/record-flare-benchmarks.mjs",
    "flare:adversarial:local": "node tooling/scripts/record-flare-adversarial.mjs",
    "flare:negative:live": "node --env-file-if-exists=.env.local tooling/scripts/record-flare-live-negative.mjs",
    "flare:ingress": "pnpm --filter @flarequorum/flare-bindings build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/flare-ingress-cli.js"
  }
