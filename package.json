{
  "name": "flare-quorum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "pnpm": "10.33.0",
    "viem": "2.47.6",
    "xrpl": "4.3.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.12",
      "fast-uri": "3.1.5",
      "hono": "4.13.1",
      "ws": "8.21.1"
    }
  },
  "scripts": {
    "build": "pnpm compile && pnpm bindings:check && pnpm docs:check && pnpm --filter @flarequorum/fcc-extension --filter @flarequorum/flare-contracts --filter @flarequorum/flare-bindings --filter @flarequorum/chain-bindings --filter @flarequorum/operator-console --filter @flarequorum/settlement-relay --filter @flarequorum/tender-room build",
    "bindings:build": "pnpm --filter @flarequorum/chain-bindings build",
    "bindings:flare:generate": "pnpm --filter @flarequorum/flare-contracts build && pnpm --filter @flarequorum/flare-bindings generate",
    "bindings:check": "pnpm --filter @flarequorum/auction-house bindings:check",
    "bindings:generate": "pnpm --filter @flarequorum/auction-house bindings:generate",
    "compile": "pnpm --filter @flarequorum/auction-house build",
    "finalizer:dry": "pnpm bindings:build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/cli.js dry-run",
    "finalizer:health": "pnpm bindings:build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/cli.js health",
    "finalizer:once": "pnpm bindings:build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/cli.js once",
    "finalizer:poll": "pnpm bindings:build && pnpm --filter @flarequorum/settlement-relay build && node --env-file-if-exists=.env.local apps/relay/dist/cli.js poll",
    "lint": "pnpm lint:scripts && pnpm docs:check && pnpm bindings:build && pnpm --filter @flarequorum/fcc-extension --filter @flarequorum/flare-contracts --filter @flarequorum/flare-bindings --filter @flarequorum/operator-console --filter @flarequorum/settlement-relay --filter @flarequorum/tender-room lint",
    "lint:scripts": "node tooling/scripts/check-node-syntax.mjs",
    "mcp": "pnpm bindings:build && pnpm --filter @flarequorum/operator-console build && node --env-file-if-exists=.env.local apps/console/dist/mcp-stdio.js",
    "secret:scan": "node tooling/scripts/scan-repository-secrets.mjs",
    "test": "pnpm bindings:build && pnpm test:tooling && pnpm --filter @flarequorum/fcc-extension --filter @flarequorum/flare-contracts --filter @flarequorum/flare-bindings --filter @flarequorum/auction-house --filter @flarequorum/chain-bindings --filter @flarequorum/operator-console --filter @flarequorum/settlement-relay --filter @flarequorum/tender-room test",
    "test:contracts": "pnpm --filter @flarequorum/auction-house test",
    "test:gate-e-static": "pnpm --filter @flarequorum/auction-house test:gate-e-static",
    "test:model": "pnpm --filter @flarequorum/auction-house test:model",
    "test:tooling": "node --test tooling/test/*.test.mjs",
    "test:nox": "pnpm --filter @flarequorum/auction-house test:feasibility:nox",
    "test:ui": "pnpm bindings:build && pnpm --filter @flarequorum/tender-room test",
    "test:ui:coverage": "pnpm bindings:build && pnpm --filter @flarequorum/tender-room test:coverage",
    "test:production": "node apps/web/scripts/smoke-production.mjs",
    "test:flare:production": "node apps/web/scripts/smoke-flare-production.mjs",
    "test:flare:accessibility": "node apps/web/scripts/smoke-flare-accessibility.mjs",
    "test:flare:xrp:draft": "node apps/web/scripts/smoke-flare-xrp-draft.mjs",
    "test:flare:xrp:checkpoint": "node apps/web/scripts/smoke-flare-funding-checkpoint.mjs",
    "test:keyboard": "node apps/web/scripts/smoke-keyboard.mjs",
    "test:sepolia:a": "pnpm --filter @flarequorum/auction-house test:sepolia:a",
    "test:sepolia:b": "pnpm --filter @flarequorum/auction-house test:sepolia:b",
    "test:sepolia:c": "pnpm --filter @flarequorum/auction-house test:sepolia:c",
    "test:sepolia:d": "pnpm --filter @flarequorum/auction-house test:sepolia:d",
    "test:sepolia:e:safe": "pnpm --filter @flarequorum/auction-house test:sepolia:e:safe",
    "test:sepolia:e:authority": "pnpm --filter @flarequorum/auction-house test:sepolia:e:authority",
    "test:sepolia:market:eoa": "pnpm --filter @flarequorum/auction-house test:sepolia:eoa",
    "test:sepolia:market:refund": "pnpm --filter @flarequorum/auction-house test:sepolia:refund",
    "test:sepolia:market:safe": "pnpm --filter @flarequorum/auction-house test:sepolia:safe",
    "test:sepolia:market:safe-viewer": "pnpm --filter @flarequorum/auction-house test:sepolia:safe-viewer",
    "test:sepolia:safe-unwrap": "pnpm --filter @flarequorum/auction-house test:sepolia:safe-unwrap",
    "test:sepolia:release:two-vendor": "pnpm --filter @flarequorum/auction-house test:sepolia:release:two-vendor",
    "preflight:release": "pnpm --filter @flarequorum/auction-house preflight:release",
    "deploy:release": "pnpm --filter @flarequorum/auction-house deploy:release",
    "upgrade:review-market": "pnpm --filter @flarequorum/auction-house upgrade:review-market",
    "deploy:safe-unwrap-preparation": "pnpm --filter @flarequorum/auction-house deploy:safe-unwrap-preparation",
    "docs:check": "node tooling/scripts/check-release-docs.mjs",
    "env:doctor": "node tooling/scripts/check-release-toolchain.mjs",
    "publish:sources:release": "pnpm --filter @flarequorum/auction-house publish:sources:release",
    "test:preflight": "node --env-file-if-exists=.env.local tooling/scripts/preflight.mjs",
    "evidence:validate": "node tooling/scripts/validate-evidence.mjs",
    "flare:judge:check": "node tooling/scripts/validate-flare-judge-package.mjs",
    "judge:verify": "node tooling/scripts/verify-judge-release.mjs",
    "judge:verify:offline": "node tooling/scripts/verify-judge-release.mjs --offline",
    "judge:verify:live": "node tooling/scripts/verify-judge-release.mjs --live",
    "judge:report:check": "node tooling/scripts/validate-judge-report.mjs",
    "judge:report:summary": "node tooling/scripts/summarize-judge-report.mjs",
    "flare:slither:v2": "node tooling/scripts/run-slither-v2.mjs",
    "flare:v2:prepare": "pnpm --filter @flarequorum/flare-contracts build && node tooling/scripts/prepare-flare-v2-release.mjs",
    "flare:v2:prepare:check": "pnpm --filter @flarequorum/flare-contracts build && node tooling/scripts/prepare-flare-v2-release.mjs --check",
    "flare:v2:deploy:preflight": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/deploy-flare-v2-candidate.mjs",
    "flare:v2:deploy": "pnpm --filter @flarequorum/flare-contracts build && node --env-file-if-exists=.env.local tooling/scripts/deploy-flare-v2-candidate.mjs --execute",
    "flare:v2:extension:preflight": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/register-fcc-market-extension.mjs",
    "flare:v2:extension:register": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/register-fcc-market-extension.mjs --execute",
    "flare:v2:machines:preflight": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/register-fcc-machines.mjs",
    "flare:v2:machines:register": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/register-fcc-machines.mjs --execute",
    "flare:v2:availability:preflight": "FCC_RELEASE_PROFILE=v2 FCC_REFRESH_MACHINE_AVAILABILITY=true node --env-file-if-exists=.env.local tooling/scripts/register-fcc-machines.mjs",
    "flare:v2:availability:refresh": "FCC_RELEASE_PROFILE=v2 FCC_REFRESH_MACHINE_AVAILABILITY=true node --env-file-if-exists=.env.local tooling/scripts/register-fcc-machines.mjs --execute",
