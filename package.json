    "flare:v2:machine:pause-preflight": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/pause-replaced-v2-machine.mjs",
    "flare:v2:machine:pause": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/pause-replaced-v2-machine.mjs --execute",
    "flare:v2:governance:preflight": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/set-fcc-governance.mjs",
    "flare:v2:governance:set": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/set-fcc-governance.mjs --execute",
    "flare:v2:success:preflight": "pnpm --filter @flarequorum/flare-bindings build && FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/run-fcc-market-lifecycle.mjs",
    "flare:v2:success": "pnpm --filter @flarequorum/flare-bindings build && FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/run-fcc-market-lifecycle.mjs --execute",
    "flare:v2:recovery:preflight": "pnpm --filter @flarequorum/flare-bindings build && FCC_RELEASE_PROFILE=v2 FCC_MARKET_SELECTION_OUTAGE_INDEX=2 FCC_MARKET_EVIDENCE_PATH=evidence/coston2/market-v2-refresh-one-result-outage.json FCC_MARKET_STATE_PATH=.local/fcc/market-v2-refresh-one-result-outage.state.json node --env-file-if-exists=.env.local tooling/scripts/run-fcc-market-lifecycle.mjs",
    "flare:v2:recovery": "pnpm --filter @flarequorum/flare-bindings build && FCC_RELEASE_PROFILE=v2 FCC_MARKET_SELECTION_OUTAGE_INDEX=2 FCC_MARKET_EVIDENCE_PATH=evidence/coston2/market-v2-refresh-one-result-outage.json FCC_MARKET_STATE_PATH=.local/fcc/market-v2-refresh-one-result-outage.state.json node --env-file-if-exists=.env.local tooling/scripts/run-fcc-market-lifecycle.mjs --execute",
    "flare:v2:credential-negative": "pnpm --filter @flarequorum/flare-bindings build && FCC_RELEASE_PROFILE=v2 FCC_PRIVATE_INGRESS_NEGATIVE=invalid-credential node --env-file-if-exists=.env.local tooling/scripts/run-fcc-private-ingress.mjs",
    "flare:v2:refund:preflight": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/run-flare-v2-refund-lifecycle.mjs",
    "flare:v2:refund": "FCC_RELEASE_PROFILE=v2 node --env-file-if-exists=.env.local tooling/scripts/run-flare-v2-refund-lifecycle.mjs --execute",
    "flare:v2:selection-refund:preflight": "FCC_RELEASE_PROFILE=v2 FCC_V2_REFUND_MODE=selection-expired node --env-file-if-exists=.env.local tooling/scripts/run-flare-v2-refund-lifecycle.mjs",
    "flare:v2:selection-refund": "FCC_RELEASE_PROFILE=v2 FCC_V2_REFUND_MODE=selection-expired node --env-file-if-exists=.env.local tooling/scripts/run-flare-v2-refund-lifecycle.mjs --execute",
    "flare:v2:promotion:check": "node --env-file-if-exists=.env.local tooling/scripts/promote-flare-v2-release.mjs",
    "flare:v2:promotion:require-ready": "node --env-file-if-exists=.env.local tooling/scripts/promote-flare-v2-release.mjs --require-ready",
    "flare:v2:promote": "node --env-file-if-exists=.env.local tooling/scripts/promote-flare-v2-release.mjs --execute",
