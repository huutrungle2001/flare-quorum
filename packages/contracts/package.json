{
  "name": "@flarequorum/auction-house",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bindings:check": "node scripts/generate-bindings.mjs --check",
    "bindings:generate": "node scripts/generate-bindings.mjs",
    "build": "hardhat build",
    "test": "hardhat build && pnpm test:production && pnpm test:feasibility",
    "test:production": "hardhat test --config hardhat.unit.config.ts --no-compile test/unit/*.test.ts test/property/*.test.mjs test/static/*.test.mjs",
    "test:feasibility": "node --test test/feasibility/gate-b-model.test.mjs test/feasibility/gate-e-static.test.mjs",
    "test:gate-e-static": "node --test test/feasibility/gate-e-static.test.mjs",
    "test:model": "node --test test/feasibility/gate-b-model.test.mjs",
    "test:feasibility:nox": "hardhat test --config hardhat.config.ts test/feasibility/gate-a.test.ts test/feasibility/gate-b.test.ts test/feasibility/gate-c.test.ts test/feasibility/gate-d.test.ts",
    "test:nox": "hardhat test --config hardhat.config.ts",
    "test:sepolia:a": "node --env-file-if-exists=../../.env.local test/feasibility/sepolia/gate-a.sepolia.mjs",
    "test:sepolia:b": "node --env-file-if-exists=../../.env.local test/feasibility/sepolia/gate-b.sepolia.mjs",
    "test:sepolia:c": "node --env-file-if-exists=../../.env.local test/feasibility/sepolia/gate-c.sepolia.mjs",
    "test:sepolia:d": "node --env-file-if-exists=../../.env.local test/feasibility/sepolia/gate-d.sepolia.mjs",
    "test:sepolia:e:safe": "node --env-file-if-exists=../../.env.local test/feasibility/sepolia/gate-e-safe.sepolia.mjs",
    "test:sepolia:e:authority": "node --env-file-if-exists=../../.env.local test/feasibility/sepolia/gate-e-authority.sepolia.mjs",
    "test:sepolia:eoa": "node --env-file-if-exists=../../.env.local test/sepolia/market-eoa.sepolia.mjs",
    "test:sepolia:refund": "node --env-file-if-exists=../../.env.local test/sepolia/market-refund.sepolia.mjs",
    "test:sepolia:safe": "node --env-file-if-exists=../../.env.local test/sepolia/market-safe.sepolia.mjs",
    "test:sepolia:safe-viewer": "node --env-file-if-exists=../../.env.local test/sepolia/market-safe-viewer.sepolia.mjs",
    "test:sepolia:generic-safe": "node --env-file-if-exists=../../.env.local test/sepolia/generic-safe-onboarding.sepolia.mjs",
    "test:sepolia:safe-unwrap": "node --env-file-if-exists=../../.env.local test/sepolia/safe-unwrap.sepolia.mjs",
    "test:sepolia:hello-world": "node --env-file-if-exists=../../.env.local test/sepolia/hackathon-hello-world.sepolia.mjs",
    "test:sepolia:release:two-vendor": "node --env-file-if-exists=../../.env.local test/sepolia/release-two-vendor.sepolia.mjs",
    "preflight:release": "node --env-file-if-exists=../../.env.local scripts/preflight-release.sepolia.mjs",
    "deploy:release": "node --env-file-if-exists=../../.env.local scripts/deploy-release.sepolia.mjs",
    "upgrade:review-market": "node --env-file-if-exists=../../.env.local scripts/upgrade-review-market.sepolia.mjs",
    "deploy:safe-factory": "node --env-file-if-exists=../../.env.local scripts/deploy-safe-module-factory.sepolia.mjs",
    "deploy:safe-unwrap-preparation": "node --env-file-if-exists=../../.env.local scripts/deploy-safe-unwrap-preparation.sepolia.mjs",
    "publish:sources:release": "node scripts/publish-release-sources.sepolia.mjs",
    "verify:deployment:release": "node --env-file-if-exists=../../.env.local verify/release-deployment.sepolia.mjs",
    "verify:deployment:test": "node --env-file-if-exists=../../.env.local verify/test-deployment.sepolia.mjs"
  },
  "devDependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "@iexec-nox/nox-confidential-contracts": "0.2.2",
    "@iexec-nox/nox-hardhat-plugin": "0.1.0",
    "@iexec-nox/nox-protocol-contracts": "0.2.4",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.3",
    "@openzeppelin/contracts": "5.6.1",
    "@safe-global/protocol-kit": "8.0.4",
    "@types/node": "24.10.1",
    "hardhat": "3.11.1",
    "typescript": "5.9.3",
    "viem": "2.47.6"
  }
}
