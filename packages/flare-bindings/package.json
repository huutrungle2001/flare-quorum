{
  "name": "@flarequorum/flare-bindings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abis/*": "./generated/abis/*.json",
    "./manifest": "./generated/manifest.json"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "viem": "2.47.6"
  },
  "devDependencies": {
    "@flarenetwork/flare-wagmi-periphery-package": "3.6.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
